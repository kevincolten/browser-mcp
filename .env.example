# ---------------------------------------------------------------------------
# REQUIRED. Shared secret for the /mcp endpoint.
# Generate with:  openssl rand -hex 32
# ---------------------------------------------------------------------------
MCP_TOKEN=changeme_generate_with_openssl_rand_hex_32

# Public port the Caddy gateway listens on (Coolify maps its domain here).
GATEWAY_PORT=8080

# Should match the timezone of your egress IP, or it's a fingerprint mismatch.
TZ=America/Los_Angeles

SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080

# Pin this once you have a working deploy, e.g. 0.0.41
PLAYWRIGHT_MCP_VERSION=latest

# Set true only if your host permits Chrome's setuid sandbox.
CHROME_ENABLE_SANDBOX=false

# Space-separated extra Chrome flags, e.g. a proxy for hostile targets:
#   CHROME_EXTRA_ARGS=--proxy-server=http://user:pass@residential.example:8080
CHROME_EXTRA_ARGS=
